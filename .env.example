# Copy to .env (docker compose reads it automatically)
VLM_PROVIDER=ollama          # ollama | gemini | mock | none
OLLAMA_MODEL=qwen2.5vl:3b    # smaller/faster alternative: moondream   (bigger: qwen2.5vl:7b)
VLM_POLICY=flag              # flag = VLM disagreement marks REVIEW; apply = VLM can drop/relabel detections
REPORT_MODE=llm              # llm (falls back to template) | template
VLM_TIMEOUT=90
GEMINI_API_KEY=              # only if VLM_PROVIDER=gemini (free key from Google AI Studio)
